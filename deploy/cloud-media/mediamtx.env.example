# Install as /etc/gohome/media/mediamtx.env with mode 0600.
# Keep this secret identical to GOHOME_MEDIAMTX_AUTH_SHARED_SECRET.
MTX_AUTHHTTPADDRESS=http://127.0.0.1:8788/internal/mediamtx/auth?secret=REPLACE_WITH_SHARED_SECRET

# Public ICE candidates. The DNS name must resolve to this server and TCP/UDP 8189 must be open.
MTX_WEBRTCADDITIONALHOSTS=gohome.ai2shx.club

# Coturn is mandatory for clients whose carrier or Wi-Fi blocks direct ICE.
# Keep the TURN secret identical to coturn's static-auth-secret.
MTX_WEBRTCICESERVERS2_0_URL=turn:gohome.ai2shx.club:3478?transport=tcp
MTX_WEBRTCICESERVERS2_0_USERNAME=AUTH_SECRET
MTX_WEBRTCICESERVERS2_0_PASSWORD=REPLACE_WITH_TURN_SECRET
MTX_WEBRTCICESERVERS2_0_CLIENTONLY=true
