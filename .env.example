# GoHome local App API platform model configuration.
# Copy to .env and fill API keys locally. Never commit real keys.

# Optional local server settings
GOHOME_APP_SERVER_PORT=8788
GOHOME_APP_SERVER_HOST=0.0.0.0

# Persistent live media authorization. Generate independent random secrets of at least 32 bytes.
# MediaMTX runs on the same host and calls the loopback-only endpoint with the shared secret.
GOHOME_MEDIA_AUTH_SECRET=
GOHOME_MEDIAMTX_AUTH_SHARED_SECRET=
GOHOME_MEDIA_WHEP_BASE_URL=https://gohome.ai2shx.club/media
GOHOME_MEDIA_READ_TTL_SECONDS=120

# Private COS memory media. Keep real CAM credentials only in the server environment.
GOHOME_COS_ENABLED=0
GOHOME_COS_BUCKET=
GOHOME_COS_REGION=ap-shanghai
GOHOME_COS_SECRET_ID=
GOHOME_COS_SECRET_KEY=
GOHOME_MEDIA_UPLOAD_SECRET=
# One lifecycle owns expired upload intents, retained assets and orphan reconciliation.
GOHOME_MEDIA_LIFECYCLE_ENABLED=1
GOHOME_MEDIA_LIFECYCLE_DELETE_ENABLED=0
GOHOME_MEDIA_LIFECYCLE_INTERVAL_MS=300000
GOHOME_COS_CRITICAL_EVIDENCE_RETENTION_DAYS=180
GOHOME_COS_EVENT_EVIDENCE_RETENTION_DAYS=90
GOHOME_COS_VERIFICATION_RETENTION_DAYS=30
GOHOME_COS_TRANSIENT_RETENTION_DAYS=7
GOHOME_COS_ORPHAN_GRACE_DAYS=2

# Internal ops page protection. Keep empty for local-only development.
# Set this before cloud deployment, then access ops.html with ?ops_token=...
GOHOME_OPS_TOKEN=

# Multimodal language / vision model. The current default remains SiliconFlow for
# backward compatibility. Provider-specific overrides below allow care text and
# safety vision verification to be switched independently.
GOHOME_MULTIMODAL_PROVIDER=siliconflow
GOHOME_MULTIMODAL_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
GOHOME_MULTIMODAL_API_KEY=
GOHOME_MULTIMODAL_MODEL=Qwen/Qwen3.5-27B

# Alibaba Bailian MaaS switch example for the OpenAI-compatible chat endpoint:
# DASHSCOPE_API_KEY=<Bailian API key>
# GOHOME_MULTIMODAL_PROVIDER=dashscope-maas
# GOHOME_MULTIMODAL_BASE_URL=https://llm-62p33orlbhzt8o8r.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# GOHOME_MULTIMODAL_MODEL=qwen3.7-plus-2026-05-26

# Optional independent overrides. Keep the vision model on a model that is
# documented by Bailian as accepting image_url input and JSON output.
GOHOME_CARE_MODEL_PROVIDER=
GOHOME_CARE_MODEL_BASE_URL=
GOHOME_CARE_MODEL_API_KEY=
GOHOME_CARE_MODEL=
GOHOME_VISION_MODEL_PROVIDER=
GOHOME_VISION_MODEL_BASE_URL=
GOHOME_VISION_MODEL_API_KEY=
GOHOME_VISION_MODEL=

# Image generation model: Alibaba Cloud DashScope Wan image generation endpoint.
GOHOME_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
GOHOME_IMAGE_API_KEY=
GOHOME_IMAGE_MODEL=wan2.7-image

# Optional prompt overrides. Leave empty to use built-in product prompts.
GOHOME_CARE_CARD_PROMPT=
GOHOME_CARE_IMAGE_PROMPT=

# Optional kill switch for external model calls. Defaults to 1 when omitted.
GOHOME_CARE_MODEL_CALLS=1

# Optional image generation kill switch. Defaults to GOHOME_CARE_MODEL_CALLS when omitted.
GOHOME_CARE_IMAGE_CALLS=1
GOHOME_CARE_IMAGE_SIZE=1024*1024
# Optional override: auto detects sync for DashScope multimodal-generation and async for task endpoints.
GOHOME_IMAGE_REQUEST_MODE=

# Optional external model request timeout.
GOHOME_MODEL_REQUEST_TIMEOUT_MS=120000

# Startup replay only considers recent events; a new evidence upload can still trigger an older event directly.
GOHOME_VISION_VERIFICATION_REPLAY_HOURS=24

# Platform data providers for care cards. Users do not configure these in the App.
# Weather: qweather uses QWeather/和风; open-meteo is a no-key fallback for local development.
GOHOME_WEATHER_PROVIDER=qweather
GOHOME_QWEATHER_BASE_URL=https://devapi.qweather.com
GOHOME_QWEATHER_GEO_BASE_URL=https://geoapi.qweather.com
GOHOME_QWEATHER_API_KEY=
# auto uses query auth for short API keys and bearer auth for JWT-like tokens.
GOHOME_QWEATHER_AUTH_MODE=auto

# Content search: Tavily is used as a candidate source for elder-interest topics and warm care prompts.
GOHOME_SEARCH_PROVIDER=tavily
GOHOME_TAVILY_BASE_URL=https://api.tavily.com/search
GOHOME_TAVILY_API_KEY=
GOHOME_TAVILY_MAX_RESULTS=5

# Optional external provider request timeout.
GOHOME_PROVIDER_REQUEST_TIMEOUT_MS=12000
